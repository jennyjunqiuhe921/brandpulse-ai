# ── 方案 A：Anthropic 官方 API ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选：指定模型
CLAUDE_MODEL=claude-sonnet-4-6

# ── 方案 B：OpenAI 兼容接口（OpenRouter / DeepSeek / Kimi / 官方 OpenAI）───
# 设置 OPENAI_API_KEY 后，系统自动走该接口，不再需要 ANTHROPIC_API_KEY
#
# OpenRouter（推荐，可调用 Claude / GPT / Gemini 等）
# 注册：https://openrouter.ai → My Keys
# OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=anthropic/claude-sonnet-4-5
#
# DeepSeek（国内便宜）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
#
# Kimi / Moonshot
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-8k

# ── ChromaDB 路径 ────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
